extends layout/layout

block vars
    -title = ''
    -bodyClass = 'page-hold'

block container
   +bnp("bnp-cd.jpg","Thông tin cổ đông","Minh bạch – Uy tín – Đồng hành phát triển","Thông tin cổ đông")
   section.sec-hold.ss-pd
      .container
         .hold
            .hold-wrap
               .hold-head.mb-40
                  +title("Thông tin cổ đông","title40 t-center")
                  .hnews-cate 
                     .b-slide.slideSw
                        +Swiper()
                           .swiper-slide.col
                              label(for="hnews-cate-1").hnews-link
                                 input(type="radio" id="hnews-cate-1" name="hnews-cate" value="1" hidden )
                                 span.txt
                                    | TẤT CẢ 
                           .swiper-slide.col
                              label(for="hnews-cate-2").hnews-link
                                 input(type="radio" id="hnews-cate-2" name="hnews-cate" value="2" hidden)
                                 span.txt
                                    | CÔNG BỐ THÔNG TIN
                           .swiper-slide.col
                              label(for="hnews-cate-3").hnews-link
                                 input(type="radio" id="hnews-cate-3" name="hnews-cate" value="3" hidden)
                                 span.txt
                                    | BÁO CÁO TÀI CHÍNH
                           .swiper-slide.col
                              label(for="hnews-cate-4").hnews-link
                                 input(type="radio" id="hnews-cate-4" name="hnews-cate" value="4" hidden)
                                 span.txt
                                    | BÁO CÁO THƯỜNG NIÊN
                           .swiper-slide.col
                              label(for="hnews-cate-5").hnews-link
                                 input(type="radio" id="hnews-cate-5" name="hnews-cate" value="5" hidden)
                                 span.txt
                                    | THÔNG TIN QUẢN TRỊ
                           .swiper-slide.col
                              label(for="hnews-cate-6").hnews-link
                                 input(type="radio" id="hnews-cate-6" name="hnews-cate" value="6" hidden)
                                 span.txt
                                    | ĐẠI HỘI CỔ ĐÔNG
                  .hold-tag.d-flex.j-center
                     +Checker("radio","tag","2021","tag-box","hnews-tag")
                     +Checker("radio","tag","2022","tag-box","hnews-tag")
                     +Checker("radio","tag","2023","tag-box","hnews-tag")
                     +Checker("radio","tag","2024","tag-box","hnews-tag")
                     +Checker("radio","tag","2025","tag-box","hnews-tag")
               .hold-block 
                  .hold-list 
                     each i,index in Array(6)
                        .hold-item 
                           a(href="").hidden-link 
                           .b-time 
                              span.t-date 03.07
                              sapn.t-year 2025
                           h3.b-title
                              |  Báo cáo tài chính quý 3, 2025
                           .b-icon 
                              +img("ic-pdf.svg")
                  +PageNumber()
   +connect()