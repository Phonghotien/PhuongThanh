extends layout/layout

block vars
    -title = ''
    -bodyClass = 'page-hold'

block container
   +bnp("bnp-cd.jpg","Thông tin cổ đông","Minh bạch – Uy tín – Đồng hành phát triển","Thông tin cổ đông")
   section.sec-hold.ss-pd
      .container
         .hold
            .hold-wrap
               .hold-head.mb-40
                  +title("Thông tin cổ đông","title40 t-center")
                  .hnews-cate 
                     .b-slide.slideSw
                        +Swiper()
                           .swiper-slide.col
                              a(href="").hnews-link.active
                                 | TẤT CẢ 
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | CÔNG BỐ THÔNG TIN
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | BÁO CÁO TÀI CHÍNH
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | BÁO CÁO THƯỜNG NIÊN
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | THÔNG TIN QUẢN TRỊ
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | ĐẠI HỘI CỔ ĐÔNG
                  .hold-tag.d-flex.j-center
                     a(href="").b-tag 2021
                     a(href="").b-tag 2022
                     a(href="").b-tag 2023 
                     a(href="").b-tag 2024 
                     a(href="").b-tag 2025
               .hold-block 
                  .hold-list 
                     each i,index in Array(6)
                        .hold-item 
                           a(href="").hidden-link 
                           .b-time 
                              span.t-date 03.07
                              sapn.t-year 2025
                           h3.b-title
                              |  Báo cáo tài chính quý 3, 2025
                           .b-icon 
                              +img("ic-pdf.svg")
                  +PageNumber()
   +connect()