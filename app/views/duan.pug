extends layout/layout

block vars
    -title = ''
    -bodyClass = 'page-project'

block container
   +bnp("bnp-project.jpg","Dự án","Công trình chất lượng – Dấu ấn trên mọi nẻo đường.","Dự án")
   section.sec-hpj.ss-pd 
      .container-second 
         .hpj
            .hpj-wrap
               .hpj-head 
                  +title("Dự án nổi bật","second white")
               .hbj-block 
                  .hpj-slider.slideSw
                     +SwiperControl("hpj-control") 
                     .b-sw 
                        +Swiper()
                           each i, index in Array(4)
                              .swiper-slide.col 
                                 .pj-item 
                                    a(href="").hidden-link 
                                    .b-top 
                                       .b-img
                                          .tag.iwt 
                                             span.icon 
                                                +img("tag-ic.svg")
                                             span.txt Hà Nội
                                          .inner 
                                             +img(`pj-img (${index + 1}).jpg`)
                                       .b-abs 
                                          .iwt 
                                             span.icon 
                                                +img("pj-ic (1).svg")
                                             .t-gr 
                                                span.text Chiều dài
                                                span.t-num 30 Km
                                          .iwt 
                                             span.icon 
                                                +img("pj-ic (2).svg")
                                             .t-gr 
                                                span.text Tổng giá trị
                                                span.t-num 6700 tỷ
                                          .iwt 
                                             span.icon 
                                                +img("pj-ic (3).svg")
                                             .t-gr 
                                                span.text Nhân sự
                                                span.t-num 1000+
                                          .iwt 
                                             span.icon 
                                                +img("pj-ic (4).svg")
                                             .t-gr 
                                                span.text Thời gian
                                                span.t-num 2014 - 2018
                                    h3.b-title
                                       a(href="").t-link
                                          |  DỰ ÁN ĐẦU TƯ NÂNG CẤP TUYẾN ĐƯỜNG PHÁP VÂN - CẦU GIẼ THEO HÌNH THỨC HỢP ĐỒNG BOT
   section.sec-prj.ss-pd
      .container 
         .prj 
            .prj-wrap 
               .prj-head.mb-40
                  +title("Tất cả dự án","title40 t-center")
                  .hnews-cate 
                     .b-slide.slideSw
                        +Swiper()
                           .swiper-slide.col
                              a(href="").hnews-link.active
                                 | TẤT CẢ 
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | DỰ ÁN SẮP TRIỂN KHAI
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | DỰ ÁN ĐANG TRIỂN KHAI
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | DỰ ÁN ĐÃ TRIỂN KHAI
                  .hold-tag.d-flex.j-center
                     a(href="").b-tag 2021
                     a(href="").b-tag 2022
                     a(href="").b-tag 2023 
                     a(href="").b-tag 2024 
                     a(href="").b-tag 2025
               .prj-block
                  .prj-list.row 
                     each i,index in Array(6)
                        .col.col-6
                           .pj-item 
                              a(href="").hidden-link 
                              .b-top 
                                 .b-img
                                    .tag.iwt 
                                       span.icon 
                                          +img("tag-ic.svg")
                                       span.txt Hà Nội
                                    .inner 
                                       +img(`pj-img (${index + 1}).jpg`)
                                 .b-abs 
                                    .iwt 
                                       span.icon 
                                          +img("pj-ic (1).svg")
                                       .t-gr 
                                          span.text Chiều dài
                                          span.t-num 30 Km
                                    .iwt 
                                       span.icon 
                                          +img("pj-ic (2).svg")
                                       .t-gr 
                                          span.text Tổng giá trị
                                          span.t-num 6700 tỷ
                                    .iwt 
                                       span.icon 
                                          +img("pj-ic (3).svg")
                                       .t-gr 
                                          span.text Nhân sự
                                          span.t-num 1000+
                                    .iwt 
                                       span.icon 
                                          +img("pj-ic (4).svg")
                                       .t-gr 
                                          span.text Thời gian
                                          span.t-num 2014 - 2018
                              h3.b-title
                                 a(href="").t-link
                                    |  DỰ ÁN ĐẦU TƯ NÂNG CẤP TUYẾN ĐƯỜNG PHÁP VÂN - CẦU GIẼ THEO HÌNH THỨC HỢP ĐỒNG BOT
                  +PageNumber()
   +connect()