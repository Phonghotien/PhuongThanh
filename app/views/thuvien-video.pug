extends layout/layout

block vars
    -title = ''
    -bodyClass = 'page-media'

block container
   +bnp("bnp-media.jpg","Thư viện","Lưu giữ dấu ấn – Lan tỏa giá trị công trình.","Thư viện")
   section.sec-media.ss-pd 
      .container 
         .media 
            .media-wrap 
               .media-head 
                  +title("Thư viện","title40 t-center")
                  .tab-group
                     a(href="").t-link HÌNH ẢNH 
                     a(href="").t-link.active VIDEO
                  .hold-tag.d-flex.j-center
                     a(href="").b-tag 2021
                     a(href="").b-tag 2022
                     a(href="").b-tag 2023 
                     a(href="").b-tag 2024 
                     a(href="").b-tag 2025
            .media-block 
               .media-masonry 
                  .masonry
                     .grid-sizer
                     .gutter-sizer
                        each i,index in Array(8)
                           .item-masonry.video-it
                              .inner
                                 +img(`media-img (${index + 1}).jpg`)
                              .inner-over 
                                 a(data-fancybox href="").icon-play
                                    +img("ic-play.svg")
                                 h3.t-text
                                    | GÓI THẦU
                                    br
                                    | HẠ LONG - VÂN ĐỒN 
   +connect()