+popup("popup-ct","popup-price-id")
   .popup-ct-main
      .t-head 
         .head.t-center
            .t-title
               | Gửi báo giá
      .b-panel 
         .b-form 
            form(action="")
               .form-list.row
                  .col.form-ip
                     input(type="text" placeholder="Họ và tên")
                  .col.form-ip.col-6
                     input(type="text" placeholder="Email")
                  .col.form-ip.col-6
                     input(type="text" placeholder="Số điện thoại")
                  .col.form-ip
                     input(type="text" placeholder="Tên công ty")
                  .col.form-ip
                     .b-select 
                        select(name="").re-select-main
                           option(value="") Chọn sản phẩm cần báo giá
                           option(value="") 1
                           option(value="") 2
                  .col.form-ip 
                     .form-file
                        .form-group
                           span.wpcf7-form-control-wrap(data-name="your-file")
                              input(id="file-send" type="file" name="your-file" class="wpcf7-form-control wpcf7-file wpcf7-validates-as-required fileInput")
                           label(for="file-send" class="filename")
                              .t-gr 
                                 span.icon
                                    +img("upload2.svg")
                                 span.txt Đính kèm file báo giá chi tiết (nếu có)
                  .col.form-ip
                     textarea(name="" placeholder="Nội dung")
               .b-submit
                  +Btn("Liên hệ với chúng tôi","button","center")
