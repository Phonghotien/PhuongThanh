mixin Lang()
  .hd-lg 
    .hd-lg-item 
      +img("ic-vn.svg")
      span.ic
        i.fas.fa-chevron-down
    .hd-lg-drop 
      a(href="").hd-lg-item 
        +img("ic-vn.svg")
