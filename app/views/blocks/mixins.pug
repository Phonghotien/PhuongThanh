mixin Btn(text, type, classCustom,icon="fa-light fa-arrow-right icon")
    if(!classCustom)
        if(type == "button")
            button.btn(type="submit",class=classCustom)
                span.inner #{text}
                i(class=icon)
        else
            a.btn(href="",class=classCustom)
                span.inner #{text}
                i(class=icon)
    else 
        if(type == "button")
            button.btn(type="submit",class=classCustom)
                span.inner #{text}
                i(class=icon)
        else
            a.btn(href="", class=classCustom)
                span.inner #{text}
                i(class=icon)
mixin PageNumber 
    ul.page-numbers
        li 
            a.prev.page-numbers(href="")
                i.fa.fa-angle-left
        li
            span.page-numbers.current   
                | 1
        li
            a.page-numbers(href="")   
                | 2
        li 
            span.page-numbers.dot 
                |...
        li
            a.page-numbers(href="")   
                | 10
        li 
            a.next.page-numbers(href="")
                i.fa.fa-angle-right
mixin breadCrumb(arr)
  .breadcrumb 
      ul.breadcrumb-list
         li.breadcrumb-item(data-aos="fade-right")
            a.breadcrumb-link(href="")
               | Trang chủ
         each txt in arr
            li.breadcrumb-item(data-aos="fade-right")
               a.breadcrumb-link(href="") #{txt}
mixin pagination(classCustom)
    .swiper-pagination(class=classCustom)

mixin CountDown(time,customClass)
   .countDownJs(class= customClass)
      .countdown(data-time=time) 
         .countdown-it.date
         .countdown-it.hour
         .countdown-it.minute
         .countdown-it.second
mixin Count()
   .count 
      .count-btn.count-minus 
         i.fas.fa-minus.icon
      input(type="text", class="count-input", max="999", min="0", value="1", hidden)
      p.count-number 1
      .count-btn.count-plus 
         i.fas.fa-plus.icon
mixin SwiperControl(customClass)
    .swiper-control(class= customClass) 
      .swiper-control-btn.swiper-prev 
          i.fa-light.fa-arrow-left
      .swiper-control-btn.swiper-next 
          i.fa-light.fa-arrow-right
mixin Swiper(customClass)
   .swiper-container 
      .swiper.rows 
         .swiper-wrapper 
            block
mixin img(name)
  img(src="./assets/images/" + name, alt="")
mixin popup(classCustom="",id="")
   .popup(class=classCustom data-popup-id= id)
      .popup-overlay
      .popup-main
         .popup-main-wrapper
            .popup-over
               .popup-wrapper
                  block
         .popup-close
            i.fas.fa-times.icon
mixin title(text,classCustom)
      .head(class=classCustom)
         h2.t-title 
            | #{text}
mixin Checker(type,shape,text,classCustom,name,num)
   if (shape == "circle")
      label.checker(class=classCustom) 
         input(type=type, name=name)
         span.circle 
         span.txt #{text}
            if(num)
               span.num #{num}
   if (shape == "checkbox") 
      label.checker(class=classCustom) 
         input(type=type , name=name)
         span.sqr 
         span.txt #{text}
            if(num)
               span.num #{num}
   if (shape == "tag")
      label.checker(class=classCustom) 
         input(type=type, name=name)
         span.txt #{text}
            if(num)
               span.num #{num}
