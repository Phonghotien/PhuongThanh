extends layout/layout

block vars
    -title = ''
    -bodyClass = 'page-home'

block container
   .bnh 
      .bnh-wrap 
         .bnh-slider.slideFade
            .bnh-sw
               +Swiper()
                  each i, index in Array(2)
                     .swiper-slide.col 
                        .bnh-item
                           .bnh-img 
                              +img(`bnh-img (${index + 1}).jpg`)
                           .container 
                              .bnh-content
                                 .b-panel
                                    .t-head 
                                       span.t-top
                                          +img("bnh-text1.svg")
                                    +Btn("Liên hệ với chúng tôi")
               +pagination("bnh-pagination")
               +SwiperControl("bnh-control")
   section.sec-hab
      .container 
         .hab 
            .hab-wrap 
               .hab-row.row 
                  .col.col-3
                     .hab-group 
                        .hab-it 
                           .t-head
                              span.t-num.countNum 03
                           .t-des 
                              p 
                                 | Đơn vị thành viên cơ cấu tổ chức
                        .hab-it 
                           .t-head
                              span.t-num.countNum 1740
                              span.t-txt 
                                 | tỷ đồng
                           .t-des 
                              p Doanh thu 2018
                        .hab-it 
                           .t-head
                              span.t-num.countNum 1200
                              span.t-txt 
                                 | Nhân viên
                           .t-des 
                              p Bao gồm các công ty thành viên
                        .hab-it 
                           .t-head
                              span.t-num.countNum 120
                              span.t-txt 
                                 | km
                           .t-des 
                              p Đường cao tốc đã thi công
                  .col.col-9
                     .hab-panel
                        .hab-list.row 
                           .col.col-6
                              .hab-image 
                                 .inner 
                                    +img("hab-img.jpg") 
                           .col.col-6
                              .hab-content
                                 +title("CON ĐƯỜNG ĐẾN TƯƠNG LAI")
                                 .b-des
                                    .mona-content 
                                       p 
                                          | Được thành lập từ năm 1999, đến nay 
                                          span.fw-7 Phương Thành Tranconsin
                                          | đã có 20 năm hình thành và phát triển.
                                       p 
                                          | Thực hiện chủ trương của Nhà nước, của Chính phủ nói chung và Bộ GTVT nói riêng, năm 2004, Phương Thành là một trong những doanh nghiệp tiên phong cổ phần hóa và nằm trong số rất ít những doanh nghiệp thành công sau cổ phần hóa.
                                       p Sau 20 năm thành lập và 15 năm cổ phần, Phương Thành có thể tự hào khẳng định được vị thế là một trong những doanh nghiệp lớn của Bộ GTVT trong lĩnh vực đầu tư và xây dựng các công trình giao thông và đặc biệt là các tuyến đường cao tốc trọng điểm của đất nước.
                                 +Btn("Xem thêm")
   section.sec-hbi.ss-pd 
      .container 
         .hbi 
            .hbi-wrap 
               .hbi-panel 
                  .b-head 
                     +title("Về Phương Thành")
                  .b-panel 
                     .iwt 
                        span.icon 
                           +img("hbi-ic (1).svg")
                        .t-gr 
                           span.text TẦM NHÌN 
                           .t-des 
                              p 
                                 | Phấn đấu trở thành doanh nghiệp hàng đầu trong lĩnh vực đầu tư và xây dựng hạ tầng giao thông, đặc biệt là các tuyến cao tốc trọng điểm.
                              p 
                                 | Phương Thành hướng đến phát triển bền vững, uy tín, vươn tầm khu vực, góp phần hiện đại hóa hệ thống giao thông quốc gia.
                     .iwt 
                        span.icon 
                           +img("hbi-ic (2).svg")
                        .t-gr 
                           span.text TẦM NHÌN 
                           .t-des
                              p 
                                 | Cung cấp các công trình giao thông chất lượng cao, hiệu quả, đúng tiến độ. Phương Thành hoạt động dựa trên giá trị cốt lõi:
                              p.fw-7
                                 | “Chân thành – Trách nhiệm – Trung thực – Hiệu quả, lấy Tâm làm nền tảng, giữ vững uy tín với đối tác, khách hàng và cộng đồng.”
               .hbi-dcor 
                  .inner 
                     +img("hbi-dc.png")
            .hbi-box
               .b-dcor 
                  +img("hbi-dc2.png")
               .t-head 
                  span.txt PHƯƠNG THÀNH TRANCOSSIN
               .b-gr 
                  span.t-dc thi công
                  span.t-num 45
                  span.txt Tỉnh thành trên khắp cả nước
   .sec-abv
      .abv-bg 
         +img("abv-bg.jpg")
      .container 
         .abv
            .abv-wrap 
               .abv-panel 
                  .abv-head 
                     +title("Giá trị cốt lõi","title40 white")
                  .abv-block 
                     .abv-list.row 
                        .col.col-3 
                           .abv-it
                              .b-head 
                                 span.icon 
                                    +img("abv-ic (1).svg")
                                 .t-gr 
                                    span.t-num 01
                                    span.txt Chân thành
                              .b-des 
                                 p 
                                    | Minh bạch, thiện chí trong mọi quan hệ, lắng nghe và chia sẻ để xây dựng niềm tin.
                        .col.col-3 
                           .abv-it
                              .b-head 
                                 span.icon 
                                    +img("abv-ic (2).svg")
                                 .t-gr 
                                    span.t-num 02
                                    span.txt  Trách nhiệm
                              .b-des 
                                 p Đúng tiến độ, đảm bảo chất lượng và an toàn, góp phần tạo giá trị bền vững.
                        .col.col-3 
                           .abv-it
                              .b-head 
                                 span.icon 
                                    +img("abv-ic (3).svg")
                                 .t-gr 
                                    span.t-num 03
                                    span.txt Trung thực
                              .b-des 
                                 p Giữ uy tín bằng hành động, minh bạch thông tin và cam kết rõ ràng.
                        .col.col-3 
                           .abv-it
                              .b-head 
                                 span.icon 
                                    +img("abv-ic (4).svg")
                                 .t-gr 
                                    span.t-num 04
                                    span.txt Hiệu quả
                              .b-des 
                                 p  Tối ưu nguồn lực, áp dụng công nghệ để mang lại kết quả vượt mong đợi.
   section.sec-hpj.ss-pd 
      .container-second 
         .hpj
            .hpj-wrap
               .hpj-head 
                  +title("Dự án nổi bật","second white")
               .hbj-block 
                  .hpj-slider.slideSw
                     +SwiperControl("hpj-control") 
                     .b-sw 
                        +Swiper()
                           each i, index in Array(4)
                              .swiper-slide.col 
                                 .pj-item 
                                    a(href="").hidden-link 
                                    .b-top 
                                       .b-img
                                          .tag.iwt 
                                             span.icon 
                                                +img("tag-ic.svg")
                                             span.txt Hà Nội
                                          .inner 
                                             +img(`pj-img (${index + 1}).jpg`)
                                       .b-abs 
                                          .iwt 
                                             span.icon 
                                                +img("pj-ic (1).svg")
                                             .t-gr 
                                                span.text Chiều dài
                                                span.t-num 30 Km
                                          .iwt 
                                             span.icon 
                                                +img("pj-ic (2).svg")
                                             .t-gr 
                                                span.text Tổng giá trị
                                                span.t-num 6700 tỷ
                                          .iwt 
                                             span.icon 
                                                +img("pj-ic (3).svg")
                                             .t-gr 
                                                span.text Nhân sự
                                                span.t-num 1000+
                                          .iwt 
                                             span.icon 
                                                +img("pj-ic (4).svg")
                                             .t-gr 
                                                span.text Thời gian
                                                span.t-num 2014 - 2018
                                    h3.b-title
                                       a(href="").t-link
                                          |  DỰ ÁN ĐẦU TƯ NÂNG CẤP TUYẾN ĐƯỜNG PHÁP VÂN - CẦU GIẼ THEO HÌNH THỨC HỢP ĐỒNG BOT
   section.sec-hw.ss-pd
      .container-second 
         .hw 
            .hw-wrap 
               .hw-head.mb-40
                  +title("Lĩnh vực hoạt động","title40")
               .hw-block 
                  .hw-slider.slideSw 
                     +SwiperControl("hw-control")
                     .b-sw 
                        +Swiper()
                           each i, index in Array(5)
                              .swiper-slide.col 
                                 .hw-it 
                                    .box-img 
                                       .inner 
                                          +img(`hw-img (${index + 1}).jpg`)
                                    .box-ctn 
                                       .b-abs
                                          span.icon 
                                             +img(`hw-ic (${index + 1}).svg`)
                                          span.t-txt XÂY DỰNG CẦU ĐƯỜNG
   section.sec-fb.ss-pd 
      .fb 
         .fb-wrap
            .fb-slider.slideFade
               .b-control 
                  +SwiperControl("fb-control")
               .b-sw
                  +Swiper()
                     each i, index in Array(2)
                        .swiper-slide.col 
                           .fb-it 
                              .fb-abs 
                                 .container 
                                    .fb-ctn 
                                       span.icon-quote 
                                          +img("ic-quote.svg")
                                       .t-des
                                          p 
                                             | “Gắn bó với Phương Thành hơn 10 năm, tôi không chỉ trưởng thành về chuyên môn mà còn học được cách làm việc có tâm, có trách nhiệm.
                                          p 
                                             | Môi trường ở đây đề cao tính kỷ luật, minh bạch nhưng cũng rất nhân văn và đoàn kết. Mỗi công trình là một thử thách, nhưng cũng là cơ hội để anh em kỹ sư, công nhân cùng nhau sáng tạo, vượt khó và để lại dấu ấn. Tôi tự hào khi được góp phần xây dựng những tuyến đường nối liền mọi miền Tổ quốc.”
                                       .b-author 
                                          .iwt 
                                             span.icon 
                                                +img("avt-img.jpg")
                                             .t-gr 
                                                span.t-name Nguyễn Văn A
                                                span.t-pos.fw-7 Kỹ sư xây dựng
                              .fb-img 
                                 .inner 
                                    +img(`fb-img (${index + 1}).jpg`)
   section.sec-bld.ss-pd-b
      .bld-bg 
         +img("bld-bg.svg")
      .container
         .bld 
            .bld-wrap 
               .bld-head.t-center.mb-40
                  +title("Ban lãnh đạo","title40")
               .bld-block 
                  .bld-image 
                     .inner 
                        +img("bld-img.png")
   section.sec-rw
      .rw-img 
         +img("rw-img.jpg")
      .container 
         .rw-head.mb-40
            .head.title40.white
               h2.t-title 
                  | Khách hàng
                  br
                  | nói gì về chúng tôi
      .container-second
         .rw-block
            .rw-slider.slideSw
               +SwiperControl("rw-control")
               .b-sw
                  +Swiper()
                     each i, index in Array(3)
                        .swiper-slide.col
                           .rw-it
                              span.icon-quote
                                 +img("ic-quote.svg")
                              .b-des
                                 p 
                                    | "Là đơn vị chủ đầu tư của dự án tuyến cao tốc trọng điểm, chúng tôi đánh giá cao năng lực thi công, tinh thần trách nhiệm và sự chuyên nghiệp của Phương Thành. Các hạng mục do công ty thực hiện đều đảm bảo chất lượng, tiến độ và tuân thủ nghiêm ngặt các tiêu chuẩn kỹ thuật. Phương Thành thực sự là đối tác tin cậy trong lĩnh vực xây dựng hạ tầng giao thông."
                              .b-bot 
                                 .b-author
                                    span.txt Đại diện Ban Quản lý
                                    span.text.fw-7 Công ty FECON S&C
                                 .b-logo 
                                    span.icon-logo 
                                       +img("logo-rw.png")
   section.sec-hnews.ss-pd 
      .container 
         .hnews
            .hnews-wrap 
               .hnews-head.t-center
                  +title("Tin tức","title40")
                  .hnews-cate 
                     .b-slide.slideSw
                        +Swiper()
                           .swiper-slide.col
                              a(href="").hnews-link.active
                                 | TẤT CẢ 
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | BẢNG TIN CÔNG TY
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | TIN NGÀNH XÂY DỰNG
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | KHEN THƯỞNG
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | SỰ KIỆN - ĐẤU THẦU
                           .swiper-slide.col
                              a(href="").hnews-link
                                 | BẢN TIN THỊ TRƯỜNG
               .hnews-block 
                  .hnews-slider.slideSw
                     .b-sw 
                        +Swiper()
                           each i, index in Array(4)
                              .swiper-slide.col.col-4 
                                 +news(index)
                  .mt-24
                     +Btn("Xem thêm","","center")
   section.sec-brand.ss-pd-b 
      .container 
         .brand
            .brand-wrap
               .brand-head.t-center.mb-24
                  +title("Đơn vị thành viên","title40")
               .brand-block 
                  .brand-slider.slideSw
                     .b-sw 
                        +Swiper()
                           each i, index in Array(4)
                              .swiper-slide.col
                                 .brand-it
                                    .inner 
                                       +img(`brand-img (${index + 1}).png`)
   section.sec-brands.ss-pd-b 
      .container 
         .brands
            .brands-wrap
               .brands-head.t-center.mb-24
                  +title("Đối tác đồng hành","title40")
      .brands-block 
         .brands-slider.slideSw
            .b-sw 
               +Swiper()
                  each i, index in Array(7)
                     .swiper-slide.col
                        .brands-it
                           .inner 
                              +img(`brands-img (${index + 1}).png`)
   +connect()