extends layout/layout

block vars
    -title = ''
    -bodyClass = 'page-career'

block container
   +bnp("bnp-td.jpg","Tuyển dụng","Minh bạch – Uy tín – Đồng hành phát triển","Tuyển dụng")
   section.sec-career.ss-pd 
      .container 
         .career
            .career-wrap
               .career-head.mb-40
                  +title("Các công việc đang tuyển","title40 t-center")
               .career-search 
                  .d-flex 
                     .b-gr
                        .b-box 
                           input(type="text" placeholder="Nhập vị trí tìm kiếm")
                        .b-box
                           .b-select 
                              select(name="").re-select-main
                                 option(value="") Chọn bộ phận
                                 option(value="") 1
                                 option(value="") 2
                        .b-box 
                           .b-select 
                              select(name="").re-select-main
                                 option(value="") Chọn khu vực      
                     .b-btn 
                        +Btn("Tìm kiếm")
               .career-block 
                  .career-list.row
                     each i,index in Array(6)
                        .col.col-6 
                           .career-item
                              .b-inner 
                                 .t-head 
                                    h3.t-text 
                                       a(href="").t-link
                                          |  Lái xe
                                    span.t-type HÀ NỘI 
                                 .b-panel 
                                    .b-group
                                       .b-item 
                                          span.text Số lượng 
                                          span.value 1
                                       .b-item 
                                          span.text Mức lương 
                                          span.value 20 - 25 triệu
                                       .b-item 
                                          span.text Hạn ứng tuyển
                                          span.value 20/05/2025
                  +PageNumber()
   +connect()